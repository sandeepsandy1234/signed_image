argin-bottom:20px}.info p{font-size:13px;color:#aaa;margin-bottom:4px}.info code{color:#e94560;font-size:15px;font-weight:bold}label{display:block;margin-bottom:8px;font-size:14px;color:#aaa}input[type=file]{width:100%;background:#0f3460;border:2px dashed #e94560;border-radius:8px;padding:16px;color:#eee;cursor:pointer;margin-bottom:16px;font-size:14px}button{width:100%;background:#e94560;color:#fff;border:none;border-radius:8px;padding:14px;font-size:16px;font-weight:bold;cursor:pointer}button:hover{background:#c73652}#status{margin-top:16px;padding:12px;border-radius:8px;display:none;font-size:14px}.ok{background:#1a3a2a;color:#4caf50;border-left:4px solid #4caf50}.err{background:#3a1a1a;color:#f44336;border-left:4px solid #f44336}.prog{background:#0f3460;color:#69f0ae;border-left:4px solid #69f0ae}</style></head><body><div class='card'><h1>&#128225; ESP32 OTA Update</h1><p class='sub'>Upload new firmware â€” device flashes and reboots automatically</p><div class='info'><p>Current firmware version:</p><code id='ver'>loading...</code></div><form id='f' enctype='multipart/form-data'><label>Select compiled firmware (.bin file):</label><input type='file' id='bin' name='firmware' accept='.bin' required><button type='submit'>&#11014; Upload &amp; Flash</button></form><div id='status'></div></div><script>fetch('/version').then(r=>r.text()).then(v=>document.getElementById('ver').textContent=v);document.getElementById('f').onsubmit=function(e){e.preventDefault();var s=document.getElementById('status');var file=document.getElementById('bin').files[0];if(!file){return;}s.className='prog';s.style.display='block';s.textContent='Uploading and flashing... do not close this page.';fetch('/upload',{method:'POST',headers:{'Content-Type':'application/octet-stream'},body:file}).then(r=>r.text()).then(function(t){s.className='ok';s.textContent=t;}).catch(function(){s.className='err';s.textContent='Upload failed. Check serial monitor.';});};</script></body></html>    ota_srv_task    rv